{
    "functions": {
        "app/api/chat/route.ts": {
            "memory": 512,
            "maxDuration": 300
        },
        "app/api/**/route.ts": {
            "memory": 256,
            "maxDuration": 10
        }
    },
    "redirects": [
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "www.gravitexai.com" }],
            "destination": "https://gravitexai.com/:path*",
            "permanent": true
        }
    ]
}
